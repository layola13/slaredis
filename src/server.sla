// server.sla -- connection table + the event loop.
//
// Concurrency model (decided on measured evidence, recorded in
// docs/M0_DELIVERY.md): ONE process, ONE thread, a round-robin loop
// over nonblocking sockets -- the same shape as Redis itself, so a
// command always executes atomically and the store needs no lock.
// The loop: wait for readiness, drain pending accepts, then for
// each connection pump one read chunk, execute every complete
// command in its buffer, flush its out buffer, and reap
// connections that are done. The expiry sweeper runs inside the
// loop every ~100 ms.
//
// The wait is a blocking poll (sa_std_net_poll_wait, the F-perf-1
// readiness face): the M0/M1 loop scanned every socket each round
// and slept 1 ms when a round made no progress; the poll loop
// blocks until a socket is ready or the next timer deadline
// (expiry sweep, AOF everysec fsync) arrives, whichever is first.
// Readiness is level-triggered, so a ready socket reported by the
// wait is only a gate on work the old loop attempted anyway: the
// accept drain runs when the listener reports READ, a connection
// read runs when the connection reports READ or ERROR (a hangup
// reports READ|ERROR; the read then returns EOF), and flushes are
// still attempted whenever output is pending. Per-round timer
// behavior is unchanged: the wait budget ends at the next sweep /
// everysec deadline, so neither cadence can be starved by an idle
// poll. Connections accepted in the current round were not part
// of its wait set and are read unconditionally, exactly as the
// old loop read them in their accept round.
//
// The wait set is staged in chunks of POLL_CHUNK handles, far
// under the face's 4096-handle cap, so no connection is ever
// left out of a wait and no call is ever oversized. Closed
// connections are excluded from the set: their handles are
// already closed, and a closed handle would fail the whole wait
// loudly with INVALID_HANDLE. If a wait itself returns a non-OK
// status, that round falls back -- explicitly, here and not
// silently -- to the pre-poll behavior (ungated scan, 1 ms sleep
// when a round makes no progress): a broken readiness face must
// degrade latency, never correctness or liveness.
//
// Measured std semantics this relies on (probe_loop, 2026-10-28):
// a would-block accept or read returns SA_STD_ERR_IO (6), NOT
// SA_STD_OK; end-of-file is SA_STD_OK with out_read == 0. Any
// non-OK read status is therefore "no data this round"; a dead
// connection still terminates via EOF on a later round or a failed
// flush followed by EOF.
@import "sa_std/net.sai"
@import "sa_std/net.sla"
@import "sa_std/time.sai"
@import "sa_std/fs.sai"
@import "sa_std/status.sla"
@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/thread.sa"
@import "sa_std/core/slice.sa"
@import "bytes.sla"
@import "store.sla"
@import "resp.sla"
@import "commands.sla"
@import "auth.sla"
@import "journal.sla"
@import "aof.sla"

struct Conn {
    stream: u64,
    inbuf: Vec<u8>,
    inoff: u64,
    outbuf: Vec<u8>,
    outoff: u64,
    open: bool,
    eof: bool,
    close_after_flush: bool,
    authed: bool,
    // Readiness bits (SA_NET_POLL_*) from the current round's
    // wait; rewritten for every open connection on every round
    // the wait succeeds, meaningless on rounds it does not.
    ready: u32,
}

fn conn_new(stream: u64, authed: bool) -> Conn {
    return Conn {
        stream: stream,
        inbuf: Vec::new(),
        inoff: 0,
        outbuf: Vec::new(),
        outoff: 0,
        open: true,
        eof: false,
        close_after_flush: false,
        authed: authed,
        ready: 0,
    };
}

// One read pump on conns[i]. Returns true when bytes arrived.
fn conn_read(conns: &Vec<Conn>, i: u64) -> bool {
    if conns[i].eof {
        return false;
    };
    let buf: [u8; 4096] = [0u8; 4096];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    let nread: u64 = 0;
    let st: i32 = sa_std_net_tcp_stream_read(conns[i].stream, bp, 4096, &nread);
    if st != SA_STD_OK {
        return false;
    };
    if nread == 0 {
        conns[i].eof = true;
        return false;
    };
    let j: u64 = 0;
    while j < nread {
        conns[i].inbuf.push(buf[j]);
        j = j + 1;
    }
    return true;
}

// Execute every complete command buffered on conns[i], appending
// replies to its out buffer. Returns true when a command ran.
//
// Per command, in order: the AUTH gate (an unauthenticated
// connection may only attempt AUTH; everything else is answered
// NOAUTH without executing), AUTH itself, BGREWRITEAOF (handled
// here because it needs the AOF state, not just the store), the
// broken-AOF write refusal, and finally normal dispatch followed
// by the journal hook (successful write commands are appended to
// the AOF before their replies are flushed).
fn conn_exec_all(s: &Store, conns: &Vec<Conn>, i: u64, now_ms: i64, auth: &AuthConfig, aof: &AofState) -> bool {
    let ran: bool = false;
    while conns[i].inoff < len(conns[i].inbuf) {
        let pr = resp_parse(&conns[i].inbuf, conns[i].inoff);
        if pr.state == PARSE_INCOMPLETE {
            break;
        };
        if pr.state == PARSE_ERROR {
            let ob_err = conns[i].outbuf;
            conns[i].outbuf = resp_error(ob_err, STR_PTR("ERR Protocol error"), STR_LEN("ERR Protocol error"));
            conns[i].close_after_flush = true;
            conns[i].inoff = len(conns[i].inbuf);
            break;
        };
        conns[i].inoff = conns[i].inoff + pr.consumed;
        if pr.state == PARSE_OK {
            // value-threaded reply buffer: move the field out, run
            // the command, assign the buffer back (probe S6 shape)
            if auth_gate_allows(auth, conns[i].authed, &pr.args) != true {
                let ob = conns[i].outbuf;
                conns[i].outbuf = resp_error(ob, STR_PTR("NOAUTH Authentication required."), STR_LEN("NOAUTH Authentication required."));
                ran = true;
            } else {
                if auth_is_auth_command(&pr.args) {
                    let ob2 = conns[i].outbuf;
                    let (ob3, ok) = cmd_auth(auth, &pr.args, ob2);
                    conns[i].outbuf = ob3;
                    if ok {
                        conns[i].authed = true;
                    };
                    ran = true;
                } else {
                    if aof_is_rewrite_command(&pr.args) {
                        let ob4 = conns[i].outbuf;
                        if len(pr.args) != 1 {
                            conns[i].outbuf = err_arity(ob4, STR_PTR("bgrewriteaof"), STR_LEN("bgrewriteaof"));
                        } else {
                            if aof.enabled != true {
                                conns[i].outbuf = resp_error(ob4, STR_PTR("ERR BGREWRITEAOF requires AOF persistence to be enabled"), STR_LEN("ERR BGREWRITEAOF requires AOF persistence to be enabled"));
                            } else {
                                if aof_rewrite(aof, s, now_ms) {
                                    conns[i].outbuf = resp_simple(ob4, STR_PTR("AOF rewrite completed"), STR_LEN("AOF rewrite completed"));
                                } else {
                                    conns[i].outbuf = resp_error(ob4, STR_PTR("ERR AOF rewrite failed"), STR_LEN("ERR AOF rewrite failed"));
                                };
                            };
                        };
                        ran = true;
                    } else {
                        // The write classification runs once per
                        // command (F-perf-4): the M1 shape ran the
                        // 17-way name comparison twice for every
                        // write and, because && does not
                        // short-circuit here, once for every read
                        // whenever AOF was enabled. Records are
                        // staged into aof.pending as commands
                        // execute and flushed once per exec pass
                        // below.
                        let is_write: bool = false;
                        if aof.enabled {
                            is_write = journal_is_write(&pr.args);
                        };
                        if is_write && aof.broken {
                            let ob5 = conns[i].outbuf;
                            conns[i].outbuf = resp_error(ob5, STR_PTR("ERR AOF write failed: persistence is broken, writes are refused"), STR_LEN("ERR AOF write failed: persistence is broken, writes are refused"));
                            ran = true;
                        } else {
                            let ob6 = conns[i].outbuf;
                            let before: u64 = len(ob6);
                            let ob7 = exec_command(s, &pr.args, now_ms, ob6);
                            conns[i].outbuf = ob7;
                            ran = true;
                            if is_write {
                                if len(conns[i].outbuf) > before {
                                    if conns[i].outbuf[before] != 45 {
                                        let rec = journal_record(&pr.args, now_ms);
                                        aof.pending.push(rec);
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    }
    // One flush for the whole exec pass (F-perf-4): the staged
    // records reach the file here, still before this
    // connection's replies are flushed by the caller (the AOF
    // ordering contract in this function's header comment). A
    // failure marks the AOF broken inside aof_flush_pending;
    // this pass's replies were already generated, exactly as
    // they were when a per-record append failed in M1.
    if aof.enabled {
        let okf = aof_flush_pending(aof, now_ms);
    };
    // compact the input buffer: drop the consumed prefix
    if conns[i].inoff == len(conns[i].inbuf) {
        conns[i].inbuf = Vec::new();
        conns[i].inoff = 0;
    } else {
        if conns[i].inoff >= 8192 {
            let rest: Vec<u8> = Vec::new();
            let rest2 = bytes_push_range(rest, &conns[i].inbuf, conns[i].inoff, len(conns[i].inbuf));
            conns[i].inbuf = rest2;
            conns[i].inoff = 0;
        };
    };
    return ran;
}

// One write flush on conns[i]. Returns true when bytes were sent.
fn conn_flush(conns: &Vec<Conn>, i: u64) -> bool {
    if conns[i].outoff >= len(conns[i].outbuf) {
        return false;
    };
    let avail: u64 = len(conns[i].outbuf) - conns[i].outoff;
    let chunk: u64 = avail;
    if chunk > 4096 {
        chunk = 4096;
    };
    let arr: [u8; 4096] = [0u8; 4096];
    let j: u64 = 0;
    while j < chunk {
        arr[j] = conns[i].outbuf[conns[i].outoff + j];
        j = j + 1;
    }
    let ap: ptr = PTR_BYTE_ADD(&arr, 0);
    let written: u64 = 0;
    let st: i32 = sa_std_net_tcp_stream_write(conns[i].stream, ap, chunk, &written);
    if st != SA_STD_OK {
        return false;
    };
    if written == 0 {
        return false;
    };
    conns[i].outoff = conns[i].outoff + written;
    if conns[i].outoff == len(conns[i].outbuf) {
        conns[i].outbuf = Vec::new();
        conns[i].outoff = 0;
    };
    return true;
}

fn conn_drained(conns: &Vec<Conn>, i: u64) -> bool {
    if conns[i].outoff == 0 {
        if len(conns[i].outbuf) == 0 {
            return true;
        };
    };
    return false;
}

// Handles staged per poll call: far under the readiness face's
// SA_NET_POLL_MAX_HANDLES cap (4096), so a wait set is built from
// POLL_CHUNK-sized calls no matter how many connections exist,
// and no connection is ever excluded from a round's wait.
const POLL_CHUNK: u64 = 128;

// The wait budget for one round, in milliseconds: time until
// the next periodic deadline -- the expiry sweep (~100 ms
// cadence, same as the pre-poll loop) or, when the AOF everysec
// policy has unsynced bytes, the next fsync deadline -- clamped
// to [0, 100]. A busy round re-enters the wait immediately
// (readiness is level-triggered, so pending work returns at
// once); an idle round wakes exactly at its next deadline, so
// neither the sweep nor the everysec fsync can be starved by
// the poll the way a fixed sleep could starve them.
fn poll_wait_budget(now_ms: i64, last_sweep: i64, aof: &AofState) -> i32 {
    let budget: i64 = last_sweep + 100 - now_ms;
    if aof.enabled {
        if aof.broken != true {
            if aof.fsync_mode == AOF_FSYNC_EVERYSEC {
                if aof.unsynced > 0 {
                    let d: i64 = aof.last_sync_ms + 1000 - now_ms;
                    if d < budget {
                        budget = d;
                    };
                };
            };
        };
    };
    if budget < 0 {
        budget = 0;
    };
    if budget > 100 {
        budget = 100;
    };
    return budget as i32;
}

// One round of readiness waiting: the listener plus every open
// connection, in POLL_CHUNK-sized calls. The first call carries
// the round's timeout; later chunks are sampled with timeout 0
// (level triggering means anything that became ready during the
// first call is still reported). Results land in Conn.ready for
// open connections and in the returned bits for the listener.
// Returns SA_STD_OK when every chunk waited cleanly; on the
// first non-OK chunk status the status is returned as-is and
// the caller treats the round as unwatched (see the header
// comment for the explicit error path). Closed connections are
// never staged (their handles are closed; see header comment).
// Returns (status, listener ready bits); the bits are 0 when
// the status is not SA_STD_OK.
//
// The staging arrays live in this helper on purpose, hoisted to
// pointers once and reused across calls: passing several inline
// PTR_BYTE_ADD(&field, 0) expressions for one struct in a single
// call is a known consumed-register trap in this toolchain (the
// F-perf-1 probe record), and per-chunk re-staging from the
// connection table keeps every array at POLL_CHUNK entries.
fn poll_wait_round(listener: u64, conns: &Vec<Conn>, timeout_ms: i32) -> (i32, u32) {
    let hs: [u64; 128] = [0u64; 128];
    let ins: [u32; 128] = [0u32; 128];
    let rds: [u32; 128] = [0u32; 128];
    let hp: ptr = PTR_BYTE_ADD(&hs, 0);
    let ip: ptr = PTR_BYTE_ADD(&ins, 0);
    let rp: ptr = PTR_BYTE_ADD(&rds, 0);
    let ready_count: u64 = 0;
    let listener_bits: u32 = 0;
    let waited: bool = false;
    let staged_listener: bool = false;
    let next_ci: u64 = 0;
    let done: bool = false;
    while done != true {
        // stage one chunk: the listener first (first chunk
        // only), then open connections in table order
        let n: u64 = 0;
        let chunk_start_ci: u64 = next_ci;
        let chunk_has_listener: bool = false;
        if staged_listener != true {
            hs[n] = listener;
            ins[n] = SA_NET_POLL_READ;
            n = n + 1;
            chunk_has_listener = true;
            staged_listener = true;
        };
        while n < POLL_CHUNK {
            if next_ci >= len(conns) {
                break;
            };
            if conns[next_ci].open {
                hs[n] = conns[next_ci].stream;
                let it: u32 = 0;
                if conns[next_ci].eof != true {
                    it = it + SA_NET_POLL_READ;
                };
                if conns[next_ci].outoff < len(conns[next_ci].outbuf) {
                    it = it + SA_NET_POLL_WRITE;
                };
                ins[n] = it;
                n = n + 1;
            };
            next_ci = next_ci + 1;
        }
        let tmo: i32 = 0;
        if waited != true {
            tmo = timeout_ms;
        };
        let st: i32 = sa_std_net_poll_wait(hp, ip, n, tmo, rp, &ready_count);
        waited = true;
        if st != SA_STD_OK {
            return (st, 0);
        };
        // scatter this chunk's ready bits back: re-walk the same
        // sequence the staging walk produced (listener first,
        // then open connections from chunk_start_ci) -- single
        // thread, nothing mutated the table in between
        let slot: u64 = 0;
        if chunk_has_listener {
            listener_bits = rds[slot];
            slot = slot + 1;
        };
        let ci: u64 = chunk_start_ci;
        while slot < n {
            if conns[ci].open {
                conns[ci].ready = rds[slot];
                slot = slot + 1;
            };
            ci = ci + 1;
        }
        if next_ci >= len(conns) {
            done = true;
        };
    }
    return (SA_STD_OK, listener_bits);
}

// Run forever; returns only on setup failure (exit-code contract
// documented in README.md). With AOF enabled, startup replays the
// file into the store and opens the append handle before the
// listener exists; any failure there exits 69 rather than serving
// a silently partial dataset.
fn run_server(s: &Store, host: Vec<u8>, port: u32, auth: AuthConfig, aof_cfg: AofConfig) -> i32 {
    if len(host) > 63 {
        return 65;
    };
    let aof = aof_state_new(&aof_cfg);
    if aof.enabled {
        let rc: i32 = aof_replay(&aof_cfg, s, sa_time_unix_ms());
        if rc != 0 {
            return 69;
        };
        if aof_open(&aof) != true {
            return 69;
        };
        aof.last_sync_ms = sa_time_unix_ms();
    };
    let harr: [u8; 64] = [0u8; 64];
    let hi: u64 = 0;
    while hi < len(host) {
        harr[hi] = host[hi];
        hi = hi + 1;
    }
    let hp: ptr = PTR_BYTE_ADD(&harr, 0);
    let listener: u64 = 0;
    let bound: u32 = 0;
    let lst: i32 = sa_std_net_tcp_listen(hp, len(host), port, &listener, &bound);
    if lst != SA_STD_OK {
        return 66;
    };
    let nbl: i32 = sa_std_net_tcp_listener_set_nonblocking(listener, 1);
    if nbl != SA_STD_OK {
        return 67;
    };
    let conns: Vec<Conn> = Vec::new();
    let last_sweep: i64 = sa_time_unix_ms();
    while true {
        // The round opens with the readiness wait (see the
        // header comment): it blocks until something is ready
        // or the next timer deadline arrives. polled_len pins
        // the table length the wait covered; connections
        // accepted below it are read unconditionally this round.
        let wait_now: i64 = sa_time_unix_ms();
        let budget: i32 = poll_wait_budget(wait_now, last_sweep, &aof);
        let (pst, lis_ready) = poll_wait_round(listener, &conns, budget);
        let poll_ok: bool = pst == SA_STD_OK;
        let polled_len: u64 = len(conns);
        let progress: bool = false;
        // drain pending accepts (bounded per round); gated on
        // the listener reporting READ when the wait succeeded --
        // an unwatched listener would only return would-block
        if poll_ok != true || (lis_ready & SA_NET_POLL_READ) != 0 {
            let accepts: i64 = 0;
            while accepts < 64 {
                let h: u64 = 0;
                let ast: i32 = sa_std_net_tcp_accept(listener, &h);
                if ast != SA_STD_OK {
                    break;
                };
                if h == 0 {
                    break;
                };
                let nb: i32 = sa_std_net_tcp_stream_set_nonblocking(h, 1);
                conns.push(conn_new(h, auth.required != true));
                progress = true;
                accepts = accepts + 1;
            }
        };
        let now_ms: i64 = sa_time_unix_ms();
        let ci: u64 = 0;
        while ci < len(conns) {
            if conns[ci].open {
                // read gate: on a watched round only a
                // connection reporting READ or ERROR is read
                // (anything else would return would-block);
                // connections beyond the wait set (accepted
                // this round) and unwatched rounds read as
                // the pre-poll loop did
                let rbits: u32 = SA_NET_POLL_READ + SA_NET_POLL_ERROR;
                if poll_ok {
                    if ci < polled_len {
                        rbits = conns[ci].ready;
                    };
                };
                let rd: bool = false;
                if (rbits & (SA_NET_POLL_READ + SA_NET_POLL_ERROR)) != 0 {
                    rd = conn_read(&conns, ci);
                    if rd {
                        progress = true;
                    };
                };
                // execute when this round brought bytes, when
                // an earlier read left a complete command
                // buffered (inoff < inbuf len is the leftover
                // test), or on an unwatched round
                if rd || conns[ci].inoff < len(conns[ci].inbuf) || poll_ok != true {
                    if conn_exec_all(s, &conns, ci, now_ms, &auth, &aof) {
                        progress = true;
                    };
                };
                if conn_flush(&conns, ci) {
                    progress = true;
                };
                if conn_drained(&conns, ci) {
                    if conns[ci].eof || conns[ci].close_after_flush {
                        let cc: i32 = sa_std_close(conns[ci].stream);
                        conns[ci].open = false;
                    };
                };
            };
            ci = ci + 1;
        }
        // reap closed connection slots when they pile up
        if len(conns) >= 256 {
            let closed: u64 = 0;
            let k: u64 = 0;
            while k < len(conns) {
                if conns[k].open != true {
                    closed = closed + 1;
                };
                k = k + 1;
            }
            if closed * 2 >= len(conns) {
                let fresh: Vec<Conn> = Vec::new();
                let m: u64 = 0;
                while m < len(conns) {
                    if conns[m].open {
                        fresh.push(Conn {
                            stream: conns[m].stream,
                            inbuf: bytes_clone(&conns[m].inbuf),
                            inoff: conns[m].inoff,
                            outbuf: bytes_clone(&conns[m].outbuf),
                            outoff: conns[m].outoff,
                            open: true,
                            eof: conns[m].eof,
                            close_after_flush: conns[m].close_after_flush,
                            authed: conns[m].authed,
                            ready: conns[m].ready,
                        });
                    };
                    m = m + 1;
                }
                conns = fresh;
            };
        };
        if now_ms - last_sweep >= 100 {
            let swept: u64 = store_sweep(s, now_ms);
            last_sweep = now_ms;
        };
        aof_tick(&aof, s, now_ms);
        // No idle sleep on the poll path: the wait at the top
        // of the round already blocked for readiness or the
        // next deadline. Only an unwatched round (the wait
        // itself failed; see the header comment) keeps the
        // pre-poll 1 ms no-progress sleep, so a broken
        // readiness face degrades to the old cadence instead
        // of spinning.
        if poll_ok != true {
            if progress != true {
                THREAD_SLEEP_MS(1);
            };
        };
    }
    return 0;
}
