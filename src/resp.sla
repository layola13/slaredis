// resp.sla -- RESP2 wire protocol: incremental parser + reply writers.
//
// The parser works on a connection's accumulated input buffer at a
// byte offset, so pipelined commands and fragmented arrivals are
// the same code path. States:
//   PARSE_OK         a command was decoded; args + consumed are set
//   PARSE_INCOMPLETE not enough bytes yet; consumed is 0
//   PARSE_ERROR      protocol error; caller replies and closes
//   PARSE_SKIP       an empty frame (bare CRLF inline, or *0 / *-1);
//                    consumed advances, no reply is produced
// Inline commands are split on whitespace runs (no quote handling --
// recorded in docs/M0_DELIVERY.md). Multibulk elements that are
// null bulks ($-1) decode to empty byte strings.
@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"
@import "sa_std/core/slice.sa"
@import "bytes.sla"

const PARSE_OK: i32 = 0;
const PARSE_INCOMPLETE: i32 = 1;
const PARSE_ERROR: i32 = 2;
const PARSE_SKIP: i32 = 3;

const RESP_MAX_BULK: u64 = 536870912;
const RESP_MAX_INLINE: u64 = 65536;

struct ParseResult {
    state: i32,
    args: Vec<Vec<u8>>,
    consumed: u64,
}

fn parse_result(state: i32, consumed: u64) -> ParseResult {
    return ParseResult { state: state, args: Vec::new(), consumed: consumed };
}

// Find the LF ending the line that starts at pos. Returns
// (found, content_end, next_pos): content is [pos, content_end)
// with a trailing CR excluded; next_pos is just past the LF.
fn find_line(buf: &Vec<u8>, pos: u64) -> (bool, u64, u64) {
    let i: u64 = pos;
    while i < len(buf) {
        if buf[i] == 10 {
            let cend: u64 = i;
            if cend > pos {
                if buf[cend - 1] == 13 {
                    cend = cend - 1;
                };
            };
            return (true, cend, i + 1);
        };
        i = i + 1;
    }
    return (false, 0, 0);
}

fn resp_parse(buf: &Vec<u8>, start: u64) -> ParseResult {
    if start >= len(buf) {
        return parse_result(PARSE_INCOMPLETE, 0);
    };
    let b0: u8 = buf[start];
    if b0 == 42 {
        // multibulk: *<n>\r\n ( $<len>\r\n<bytes>\r\n ) * n
        let (found, cend, next) = find_line(buf, start + 1);
        if found != true {
            return parse_result(PARSE_INCOMPLETE, 0);
        };
        let (ok, n) = parse_i64_range(buf, start + 1, cend);
        if ok != true {
            return parse_result(PARSE_ERROR, 0);
        };
        if n <= 0 {
            return parse_result(PARSE_SKIP, next - start);
        };
        if n > 1024 {
            return parse_result(PARSE_ERROR, 0);
        };
        let args: Vec<Vec<u8>> = Vec::new();
        let pos: u64 = next;
        let k: i64 = 0;
        while k < n {
            if pos >= len(buf) {
                return parse_result(PARSE_INCOMPLETE, 0);
            };
            if buf[pos] != 36 {
                return parse_result(PARSE_ERROR, 0);
            };
            let (f2, c2, n2) = find_line(buf, pos + 1);
            if f2 != true {
                return parse_result(PARSE_INCOMPLETE, 0);
            };
            let (ok2, blen) = parse_i64_range(buf, pos + 1, c2);
            if ok2 != true {
                return parse_result(PARSE_ERROR, 0);
            };
            if blen < -1 {
                return parse_result(PARSE_ERROR, 0);
            };
            if blen == -1 {
                args.push(Vec::new());
                pos = n2;
            } else {
                let blen_u: u64 = blen as u64;
                if blen_u > RESP_MAX_BULK {
                    return parse_result(PARSE_ERROR, 0);
                };
                // need the payload plus its trailing CRLF
                if len(buf) - n2 < blen_u + 2 {
                    return parse_result(PARSE_INCOMPLETE, 0);
                };
                if buf[n2 + blen_u] != 13 {
                    return parse_result(PARSE_ERROR, 0);
                };
                if buf[n2 + blen_u + 1] != 10 {
                    return parse_result(PARSE_ERROR, 0);
                };
                let arg: Vec<u8> = Vec::new();
                let arg2 = bytes_push_range(arg, buf, n2, n2 + blen_u);
                args.push(arg2);
                pos = n2 + blen_u + 2;
            };
            k = k + 1;
        }
        let done = parse_result(PARSE_OK, pos - start);
        done.args = args;
        return done;
    };
    // inline command: one line, whitespace-split
    let (found2, cend2, next2) = find_line(buf, start);
    if found2 != true {
        if len(buf) - start > RESP_MAX_INLINE {
            return parse_result(PARSE_ERROR, 0);
        };
        return parse_result(PARSE_INCOMPLETE, 0);
    };
    let args2: Vec<Vec<u8>> = Vec::new();
    let p: u64 = start;
    while p < cend2 {
        while p < cend2 {
            if buf[p] != 32 {
                if buf[p] != 9 {
                    break;
                };
            };
            p = p + 1;
        }
        if p >= cend2 {
            break;
        };
        let tok: Vec<u8> = Vec::new();
        while p < cend2 {
            if buf[p] == 32 || buf[p] == 9 {
                break;
            };
            tok.push(buf[p]);
            p = p + 1;
        }
        args2.push(tok);
    }
    if len(args2) == 0 {
        return parse_result(PARSE_SKIP, next2 - start);
    };
    let done2 = parse_result(PARSE_OK, next2 - start);
    done2.args = args2;
    return done2;
}

// ---- reply writers ----
// All value-threaded: the out buffer moves in and back out. This
// is forced by the referee (pushing into a borrowed Vec inside a
// loop is a PhiStateConflict; see bytes.sla's note) and matches
// the sla_ecs value-threading idiom.

fn resp_simple(out: Vec<u8>, lit: ptr, lit_len: u64) -> Vec<u8> {
    out.push(43);
    out = bytes_push_lit(out, lit, lit_len);
    out.push(13);
    out.push(10);
    return out;
}

fn resp_error(out: Vec<u8>, lit: ptr, lit_len: u64) -> Vec<u8> {
    out.push(45);
    out = bytes_push_lit(out, lit, lit_len);
    out.push(13);
    out.push(10);
    return out;
}

fn resp_int(out: Vec<u8>, v: i64) -> Vec<u8> {
    out.push(58);
    out = append_i64(out, v);
    out.push(13);
    out.push(10);
    return out;
}

fn resp_bulk(out: Vec<u8>, data: &Vec<u8>) -> Vec<u8> {
    out.push(36);
    out = append_i64(out, len(data) as i64);
    out.push(13);
    out.push(10);
    out = bytes_push_range(out, data, 0, len(data));
    out.push(13);
    out.push(10);
    return out;
}

fn resp_nil(out: Vec<u8>) -> Vec<u8> {
    out.push(36);
    out.push(45);
    out.push(49);
    out.push(13);
    out.push(10);
    return out;
}

fn resp_array_header(out: Vec<u8>, n: i64) -> Vec<u8> {
    out.push(42);
    out = append_i64(out, n);
    out.push(13);
    out.push(10);
    return out;
}
