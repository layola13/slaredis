// main.sla -- slaredis entry point.
//
// Configuration is environment-only:
//   SLAREDIS_HOST       bind address, default "127.0.0.1"
//                       (loopback-only unless explicitly set)
//   SLAREDIS_PORT       port, default 6379; must be 1..65535
//   SLAREDIS_PASSWORD   when set non-empty, connections must AUTH
//   SLAREDIS_AOF_PATH   when set non-empty, AOF persistence is
//                       enabled at this path (max 255 bytes)
//   SLAREDIS_AOF_FSYNC  always | everysec | no (default everysec;
//                       see docs/PERSISTENCE.md for the rationale)
//   SLAREDIS_LOOP_MODEL poll | goroutine (default poll until the
//                       goroutine model's acceptance gates pass;
//                       see docs/GOROUTINE_DELIVERY.md). "poll"
//                       is the original single-thread readiness
//                       loop (server.sla); "goroutine" is the
//                       per-connection goroutine model
//                       (gserver.sla).
//   SLAREDIS_YIELD_EVERY  goroutine model only: manual
//                       sa_task_yield cadence for its CPU loops
//                       (default 128 commands; 0 disables -- a
//                       bench position, see the delivery doc).
// Exit codes: 0 never returns (server loop); 64 invalid
// SLAREDIS_PORT; 65 invalid SLAREDIS_HOST; 66 listen failed;
// 67 listener setup failed; 68 invalid persistence config;
// 69 AOF startup failure (replay or open); 70 invalid
// SLAREDIS_LOOP_MODEL; 71 a core goroutine died under the
// supervisor (goroutine model only).
@import "sa_std/env.sai"
@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/core/box.sa"
@import "bytes.sla"
@import "store.sla"
@import "auth.sla"
@import "aof.sla"
@import "server.sla"
@import "gserver.sla"

struct EnvValue { present: bool, value: Vec<u8> }

// Read an environment variable into bytes.
// (A struct return, not a tuple: tuple types containing a generic
// type fail to parse in this toolchain — tuple returns of pure
// primitives elsewhere in this codebase are unaffected.)
fn env_value(name: ptr, name_len: u64) -> EnvValue {
    let h: u64 = sa_env_get(name, name_len);
    if h == 0 {
        return EnvValue { present: false, value: Vec::new() };
    };
    let data: ptr = sa_env_buffer_data(h);
    let n: u64 = sa_env_buffer_len(h);
    let out: Vec<u8> = Vec::new();
    let i: u64 = 0;
    while i < n {
        out.push(PTR_BYTE_AT(data, i));
        i = i + 1;
    }
    let freed: i32 = sa_env_buffer_free(h);
    return EnvValue { present: true, value: out };
}

fn lit_bytes(lit: ptr, lit_len: u64) -> Vec<u8> {
    let out: Vec<u8> = Vec::new();
    return bytes_push_lit(out, lit, lit_len);
}

fn main() -> i32 {
    let host: Vec<u8> = lit_bytes(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    let host_env = env_value(STR_PTR("SLAREDIS_HOST"), STR_LEN("SLAREDIS_HOST"));
    if host_env.present {
        if len(host_env.value) == 0 || len(host_env.value) > 63 {
            return 65;
        };
        host = host_env.value;
    };
    let port: u32 = 6379;
    let port_env = env_value(STR_PTR("SLAREDIS_PORT"), STR_LEN("SLAREDIS_PORT"));
    if port_env.present {
        let (ok, v) = parse_i64_full(&port_env.value);
        if ok != true || v < 1 || v > 65535 {
            return 64;
        };
        port = v as u32;
    };
    let auth_cfg = auth_config_from_env();
    let (aof_status, aof_cfg) = aof_config_from_env();
    if aof_status != 0 {
        return aof_status;
    };
    // The store starts as a plain value. The goroutine model
    // takes it by value (its executor owns it as a value field
    // of its state block -- see gserver.sla's ExecSt note on
    // why borrows of an already-boxed value struct are not
    // used there); the poll model keeps its historical shape
    // and gets the store boxed, borrowed back through the
    // &(*p) bridge in this frame.
    let store = store_new();
    let model_env = env_value(STR_PTR("SLAREDIS_LOOP_MODEL"), STR_LEN("SLAREDIS_LOOP_MODEL"));
    let goroutine_model: bool = false;
    if model_env.present {
        if bytes_eq_lit_ci(&model_env.value, STR_PTR("goroutine"), STR_LEN("goroutine")) {
            goroutine_model = true;
        } else {
            if bytes_eq_lit_ci(&model_env.value, STR_PTR("poll"), STR_LEN("poll")) {
                goroutine_model = false;
            } else {
                return 70;
            };
        };
    };
    if goroutine_model {
        return run_server_goroutine(store, host, port, auth_cfg, aof_cfg);
    };
    let store_box = Box::into_raw(Box::new(store));
    return run_server(&(*store_box), host, port, auth_cfg, aof_cfg);
}

// The env-value moves below happen only on return paths: moving
// a field out of an EnvValue inside a nested branch leaves the
// register Consumed on one merge edge and Active on the other
// (PhiStateConflict), so each helper returns the finished config
// instead of assigning conditionally.
fn auth_config_from_env() -> AuthConfig {
    let pw_env = env_value(STR_PTR("SLAREDIS_PASSWORD"), STR_LEN("SLAREDIS_PASSWORD"));
    if pw_env.present {
        if len(pw_env.value) > 0 {
            return AuthConfig { required: true, password: pw_env.value };
        };
    };
    return AuthConfig { required: false, password: Vec::new() };
}

// Returns (status, config): status 68 on an invalid persistence
// configuration (over-long AOF path, unknown fsync mode). The
// config is always bound to a named local before the tuple
// return: a struct literal nested directly in a tuple literal
// leaves the construction register live at the return (a
// MemoryLeak referee trap in the current toolchain).
fn aof_config_from_env() -> (i32, AofConfig) {
    let mode: u8 = AOF_FSYNC_EVERYSEC;
    let fs_env = env_value(STR_PTR("SLAREDIS_AOF_FSYNC"), STR_LEN("SLAREDIS_AOF_FSYNC"));
    if fs_env.present {
        if bytes_eq_lit_ci(&fs_env.value, STR_PTR("always"), STR_LEN("always")) {
            mode = AOF_FSYNC_ALWAYS;
        } else {
            if bytes_eq_lit_ci(&fs_env.value, STR_PTR("everysec"), STR_LEN("everysec")) {
                mode = AOF_FSYNC_EVERYSEC;
            } else {
                if bytes_eq_lit_ci(&fs_env.value, STR_PTR("no"), STR_LEN("no")) {
                    mode = AOF_FSYNC_NO;
                } else {
                    let bad = AofConfig { enabled: false, path: Vec::new(), fsync_mode: AOF_FSYNC_EVERYSEC };
                    return (68, bad);
                };
            };
        };
    };
    let aof_env = env_value(STR_PTR("SLAREDIS_AOF_PATH"), STR_LEN("SLAREDIS_AOF_PATH"));
    if aof_env.present {
        if len(aof_env.value) > 255 {
            let bad2 = AofConfig { enabled: false, path: Vec::new(), fsync_mode: AOF_FSYNC_EVERYSEC };
            return (68, bad2);
        };
        if len(aof_env.value) > 0 {
            let ok_cfg = AofConfig { enabled: true, path: aof_env.value, fsync_mode: mode };
            return (0, ok_cfg);
        };
    };
    let off_cfg = AofConfig { enabled: false, path: Vec::new(), fsync_mode: mode };
    return (0, off_cfg);
}
