// store.sla -- the slaredis keyspace.
//
// Representation:
//   One Entry per key in a single Vec (Store.entries); every
//   key-based access goes through the B1 open-addressing index
//   layered over it (Store.index: key hash -> entry index,
//   power-of-two capacity, load factor 0.7, linear probing), so
//   find/insert are expected O(1) instead of the M0 linear scan.
//   The entries Vec and all index-based command code are the M0
//   shape unchanged, and two invariants keep the index layer
//   unobservable: tombstone slots are reused smallest-first
//   (Store.free_slots is a min-heap -- exactly the slot the old
//   scan reported first, so the entries order, and therefore
//   the AOF rewrite byte order, is unchanged), and compaction
//   rebuilds the index wholesale. Payloads live inline in the
//   Entry as Vec<u8> byte strings / Vec pairs. Since M1, small
//   aggregates (hash / set / zset) start in the compact listpack
//   representation (Entry.pack, listpack.sla) and convert
//   one-way to the plain vectors past the thresholds declared
//   below -- the same shape Redis uses, with intset/skiplist/
//   rax still future work. Deletion and expiry tombstone the
//   entry (kind = KIND_DEAD, payloads released); insert reuses
//   dead slots, and the sweeper compacts when tombstones
//   dominate.
//
// Expiry: expire_ms is a unix-ms deadline, 0 = no expiry. Expiry is
// enforced lazily inside store_find (an expired key is tombstoned
// and reported missing) and actively by store_sweep from the server
// loop.
@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"
@import "sa_std/core/slice.sa"
@import "bytes.sla"
@import "listpack.sla"

const KIND_DEAD: u8 = 0;
const KIND_STRING: u8 = 1;
const KIND_HASH: u8 = 2;
const KIND_LIST: u8 = 3;
const KIND_SET: u8 = 4;
const KIND_ZSET: u8 = 5;

// Value representations (M1). Aggregate kinds (hash / set / zset)
// start PACKED: their elements live in one listpack byte string
// (Entry.pack, see listpack.sla) and the payload vectors stay
// empty. When a packed aggregate grows past the thresholds below
// it converts one-way to PLAIN (the M0 vectors), exactly like
// Redis's listpack -> hashtable/skiplist conversion. Strings and
// lists are always PLAIN.
const ENC_PLAIN: u8 = 0;
const ENC_PACKED: u8 = 1;

// Conversion thresholds (Redis defaults): a packed aggregate
// converts when a write would push it past 128 logical elements
// (hash fields / set members / zset members) or would insert an
// element longer than 64 bytes.
const PACK_MAX_LOGICAL: u64 = 128;
const PACK_MAX_ELEM_BYTES: u64 = 64;

// One sorted-set row. Scores live in a struct field because bare
// Vec<f64> element reads return 0.0 with the current toolchain
// (minimal repro in docs/M0_DELIVERY.md); struct-field f64 access
// is verified correct.
struct ZRow {
    member: Vec<u8>,
    score: f64,
}

struct Entry {
    key: Vec<u8>,
    key_hash: u64,
    kind: u8,
    expire_ms: i64,
    enc: u8,
    pack: Vec<u8>,
    sval: Vec<u8>,
    hfields: Vec<Vec<u8>>,
    hvalues: Vec<Vec<u8>>,
    litems: Vec<Vec<u8>>,
    // Head offset of the list deque (F-perf-3): the logical list
    // is litems[lhead .. len(litems)], so LPUSH/LPOP at the head
    // are O(1) slot operations instead of O(n) deep-clone
    // rebuilds. Slots below lhead hold released (empty) values.
    // entry_clone / entry_materialized always normalize a list
    // back to lhead == 0, so consumers outside the list commands
    // (the AOF serializer) never see the offset.
    lhead: u64,
    smembers: Vec<Vec<u8>>,
    zrows: Vec<ZRow>,
    // Member index for PLAIN aggregates (knife1, 2026-11-02):
    // open addressing over the entry kind's member sequence
    // (smembers for sets, hfields for hashes, zrows[].member
    // for zsets), mapping member hash -> member position + 1
    // (0 = empty, MIDX_TOMB = deleted). It exists because the
    // plain membership tests were linear scans over the member
    // vector (~0.15-0.35 us per member per op measured: a
    // 30k-member set paid ~3 ms per SISMEMBER miss and SADD
    // collapsed to ~1k rps in the 10k-member benchmark scene).
    // Built lazily by the membership helpers once a payload
    // reaches MIDX_MIN members, maintained incrementally on
    // appends, and dropped wholesale on any order-shifting
    // removal (positions would move; the next lookup rebuilds).
    // Never serialized: clones/materializations drop it, so
    // AOF bytes and reply bytes are unaffected.
    midx: Vec<i64>,
    midx_tombs: u64,
}

struct Store {
    entries: Vec<Entry>,
    dead_count: u64,
    // B1 key index (open addressing over `entries`): cell value
    // is entry index + 1, 0 = empty, IDX_TOMB = a deleted key's
    // cell (probing continues past it). Length is a power of two
    // (0 = not built yet; built lazily on first insert).
    // index_tombs counts IDX_TOMB cells.
    index: Vec<i64>,
    index_tombs: u64,
    // Tombstoned entry slots awaiting reuse, as a min-heap
    // (smallest slot on top). Insert reuses the smallest dead
    // slot -- the same slot the pre-B1 linear scan reported --
    // so entries order is preserved exactly.
    free_slots: Vec<u64>,
}

fn entry_blank(key: &Vec<u8>, key_hash: u64, kind: u8) -> Entry {
    return Entry {
        key: bytes_clone(key),
        key_hash: key_hash,
        kind: kind,
        expire_ms: 0,
        enc: ENC_PLAIN,
        pack: Vec::new(),
        sval: Vec::new(),
        hfields: Vec::new(),
        hvalues: Vec::new(),
        litems: Vec::new(),
        lhead: 0,
        smembers: Vec::new(),
        zrows: Vec::new(),
        midx: Vec::new(),
        midx_tombs: 0,
    };
}

fn store_new() -> Store {
    return Store {
        entries: Vec::new(),
        dead_count: 0,
        index: Vec::new(),
        index_tombs: 0,
        free_slots: Vec::new(),
    };
}

// ---- B1 key index: open addressing over the entries Vec ----
//
// Cells hold entry index + 1; 0 is empty and IDX_TOMB marks a
// deleted key (probes skip it, inserts may claim it). The table
// is a power of two, grows (or is rehashed in place to clear
// tombstones) whenever an insert would push (live + tombs) past
// a 0.7 load factor. Bucket placement runs the stored FNV-1a
// key hash through the splitmix64 finalizer so sequential keys
// ("key:000001", "key:000002", ...) scatter across the table
// instead of clustering in FNV's correlated low bits.

const IDX_TOMB: i64 = -1;

fn idx_mix(h: u64) -> u64 {
    let mz: u64 = h;
    mz = (mz ^ (mz >> 30)) * 13787848793156543929u64;
    mz = (mz ^ (mz >> 27)) * 10723151780598845931u64;
    return mz ^ (mz >> 31);
}

// Probe the index for `key`. Returns (entry_index, cell) with
// entry_index >= 0 on a live hit (cell = the cell holding it),
// or entry_index == -1 with cell = where an insert of this key
// belongs (the first tombstone cell passed, else the empty cell
// that ended the probe). An empty (never-built) index reports
// (-1, 0); callers that insert build the table first (idx_ensure).
fn idx_probe(s: &Store, key: &Vec<u8>, key_hash: u64) -> (i64, u64) {
    let ix_cap: u64 = len(s.index);
    if ix_cap == 0 {
        return (-1, 0);
    };
    let ix_mask: u64 = ix_cap - 1;
    let ix_pos: u64 = idx_mix(key_hash) & ix_mask;
    let ix_tomb: i64 = -1;
    let ix_n: u64 = 0;
    while ix_n < ix_cap {
        let ix_cell: i64 = s.index[ix_pos];
        if ix_cell == 0 {
            if ix_tomb >= 0 {
                return (-1, ix_tomb as u64);
            };
            return (-1, ix_pos);
        };
        if ix_cell == IDX_TOMB {
            if ix_tomb < 0 {
                ix_tomb = ix_pos as i64;
            };
        } else {
            let ix_ei: u64 = (ix_cell - 1) as u64;
            if s.entries[ix_ei].kind != KIND_DEAD {
                if s.entries[ix_ei].key_hash == key_hash {
                    if bytes_eq(&s.entries[ix_ei].key, key) {
                        return (ix_ei as i64, ix_pos);
                    };
                };
            };
        };
        ix_pos = (ix_pos + 1) & ix_mask;
        ix_n = ix_n + 1;
    }
    // No empty cell exists (the 0.7 load invariant should make
    // this unreachable): fall back to the first tombstone cell.
    if ix_tomb >= 0 {
        return (-1, ix_tomb as u64);
    };
    return (-1, 0);
}

// Place entry `ei` in a freshly built (all-empty) index by hash
// alone -- keys are unique, so no byte comparison is needed.
fn idx_put_fresh(s: &Store, key_hash: u64, ei: u64) {
    let pf_mask: u64 = len(s.index) - 1;
    let pf_pos: u64 = idx_mix(key_hash) & pf_mask;
    while s.index[pf_pos] != 0 {
        pf_pos = (pf_pos + 1) & pf_mask;
    }
    s.index[pf_pos] = (ei as i64) + 1;
}

// Rebuild the index at capacity `new_cap` (a power of two) from
// the live entries; tombstone cells are dropped.
fn idx_rehash(s: &Store, new_cap: u64) {
    let rh_fresh: Vec<i64> = Vec::new();
    let rh_i: u64 = 0;
    while rh_i < new_cap {
        rh_fresh.push(0);
        rh_i = rh_i + 1;
    }
    s.index = rh_fresh;
    s.index_tombs = 0;
    let rh_j: u64 = 0;
    while rh_j < len(s.entries) {
        if s.entries[rh_j].kind != KIND_DEAD {
            idx_put_fresh(s, s.entries[rh_j].key_hash, rh_j);
        };
        rh_j = rh_j + 1;
    }
}

// Smallest power-of-two capacity >= 64 that keeps `live` keys
// at or under the 0.7 load factor.
fn idx_cap_for(live: u64) -> u64 {
    let cf_cap: u64 = 64;
    while live * 10 > cf_cap * 7 {
        cf_cap = cf_cap * 2;
    }
    return cf_cap;
}

// Guarantee room for one more key before an insert: build the
// index on first use, grow it when the insert would cross the
// 0.7 load factor, and rehash in place (same capacity) when
// tombstone cells are what crosses it.
fn idx_ensure(s: &Store) {
    let ie_live: u64 = len(s.entries) - s.dead_count;
    let ie_cap: u64 = len(s.index);
    if ie_cap == 0 {
        idx_rehash(s, idx_cap_for(ie_live + 1));
        return;
    };
    let ie_used: u64 = ie_live + s.index_tombs;
    if (ie_used + 1) * 10 > ie_cap * 7 {
        let ie_want: u64 = idx_cap_for(ie_live + 1);
        if ie_want < ie_cap {
            idx_rehash(s, ie_cap);
        } else {
            idx_rehash(s, ie_want);
        };
    };
}

// Record entry `ei` as the index target for `key` (the caller
// has run idx_ensure and verified the key absent; a hit here
// would mean a duplicate insert, and the cell is repointed so
// the index at least tracks the newest entry).
fn idx_insert(s: &Store, key: &Vec<u8>, key_hash: u64, ei: u64) {
    let (ii_found, ii_pos) = idx_probe(s, key, key_hash);
    if ii_found < 0 {
        if s.index[ii_pos] == IDX_TOMB {
            s.index_tombs = s.index_tombs - 1;
        };
    };
    s.index[ii_pos] = (ei as i64) + 1;
}

// Drop entry `ei` from the index, leaving a tombstone cell so probe
// chains that pass through it stay intact. Located by entry index
// alone (cells hold ei+1, unique per live entry), so the caller
// never has to borrow the entry key alongside the store -- this
// keeps entry_tombstone's borrow of `s` conflict-free. A probe
// that reaches an empty cell without seeing ei+1 means the entry
// is not indexed (e.g. repointed by a duplicate insert); that is
// a no-op, matching the old key-based form's miss behaviour.
fn idx_remove(s: &Store, key_hash: u64, ei: u64) {
    let ir_cap: u64 = len(s.index);
    if ir_cap == 0 {
        return;
    };
    let ir_mask: u64 = ir_cap - 1;
    let ir_want: i64 = (ei as i64) + 1;
    let ir_pos: u64 = idx_mix(key_hash) & ir_mask;
    let ir_n: u64 = 0;
    while ir_n < ir_cap {
        let ir_cell: i64 = s.index[ir_pos];
        if ir_cell == 0 {
            return;
        };
        if ir_cell == ir_want {
            s.index[ir_pos] = IDX_TOMB;
            s.index_tombs = s.index_tombs + 1;
            return;
        };
        ir_pos = (ir_pos + 1) & ir_mask;
        ir_n = ir_n + 1;
    }
}

// ---- member index for PLAIN aggregates (knife1) ----
//
// Same open-addressing discipline as the B1 key index, one
// level down: cells hold member position + 1, 0 is empty,
// MIDX_TOMB marks a dropped slot (this index has no shifting
// removals -- a payload removal drops the whole index instead,
// see midx_drop). Bucket placement reuses bytes_hash + idx_mix.
// The index is a pure cache of the member vector's contents:
// every answer it gives is verified by a full byte compare
// against the member at the cell's position, exactly as
// idx_probe verifies against the entry key.

const MIDX_TOMB: i64 = -1;

// Payloads smaller than this keep the linear membership scan:
// the scan's worst case there is a few microseconds and the
// index's fixed costs (build, memory) would dominate. Packed
// aggregates convert at 129 logical elements, so plain payloads
// normally cross this threshold at conversion time.
const MIDX_MIN: u64 = 32;

// Member count of entry e's plain payload (0 for kinds without
// a member sequence).
fn midx_len(s: &Store, e: u64) -> u64 {
    if s.entries[e].kind == KIND_SET {
        return len(s.entries[e].smembers);
    };
    if s.entries[e].kind == KIND_HASH {
        return len(s.entries[e].hfields);
    };
    if s.entries[e].kind == KIND_ZSET {
        return len(s.entries[e].zrows);
    };
    return 0;
}

// Full byte compare of the member at position `pos` against
// `member`, in entry e's kind sequence.
fn midx_eq_at(s: &Store, e: u64, pos: u64, member: &Vec<u8>) -> bool {
    if s.entries[e].kind == KIND_SET {
        return bytes_eq(&s.entries[e].smembers[pos], member);
    };
    if s.entries[e].kind == KIND_HASH {
        return bytes_eq(&s.entries[e].hfields[pos], member);
    };
    if s.entries[e].kind == KIND_ZSET {
        return bytes_eq(&s.entries[e].zrows[pos].member, member);
    };
    return false;
}

// Hash of the member at position `pos` in entry e.
fn midx_hash_at(s: &Store, e: u64, pos: u64) -> u64 {
    if s.entries[e].kind == KIND_SET {
        return bytes_hash(&s.entries[e].smembers[pos]);
    };
    if s.entries[e].kind == KIND_HASH {
        return bytes_hash(&s.entries[e].hfields[pos]);
    };
    if s.entries[e].kind == KIND_ZSET {
        return bytes_hash(&s.entries[e].zrows[pos].member);
    };
    return 0;
}

// Place position `pos` (whose member hash is `mh`) into a
// built index by hash + byte compare: members are unique, so a
// compare hit can only be the same member (a duplicate insert
// keeps the first position, matching scan order).
fn midx_put(s: &Store, e: u64, mh: u64, pos: u64, member: &Vec<u8>) {
    let mp_cap: u64 = len(s.entries[e].midx);
    let mp_mask: u64 = mp_cap - 1;
    let mp_pos: u64 = idx_mix(mh) & mp_mask;
    let mp_tomb: i64 = -1;
    let mp_n: u64 = 0;
    while mp_n < mp_cap {
        let mp_cell: i64 = s.entries[e].midx[mp_pos];
        if mp_cell == 0 {
            if mp_tomb >= 0 {
                s.entries[e].midx[mp_tomb as u64] = (pos as i64) + 1;
                s.entries[e].midx_tombs = s.entries[e].midx_tombs - 1;
                return;
            };
            s.entries[e].midx[mp_pos] = (pos as i64) + 1;
            return;
        };
        if mp_cell == MIDX_TOMB {
            if mp_tomb < 0 {
                mp_tomb = mp_pos as i64;
            };
        } else {
            if midx_eq_at(s, e, (mp_cell - 1) as u64, member) {
                return;
            };
        };
        mp_pos = (mp_pos + 1) & mp_mask;
        mp_n = mp_n + 1;
    }
    if mp_tomb >= 0 {
        s.entries[e].midx[mp_tomb as u64] = (pos as i64) + 1;
        s.entries[e].midx_tombs = s.entries[e].midx_tombs - 1;
    };
}

// (Re)build entry e's member index from its payload vector.
fn midx_rebuild(s: &Store, e: u64) {
    let mr_n: u64 = midx_len(s, e);
    let mr_fresh: Vec<i64> = Vec::new();
    let mr_i: u64 = 0;
    let mr_cap: u64 = idx_cap_for(mr_n);
    while mr_i < mr_cap {
        mr_fresh.push(0);
        mr_i = mr_i + 1;
    }
    s.entries[e].midx = mr_fresh;
    s.entries[e].midx_tombs = 0;
    let mr_j: u64 = 0;
    while mr_j < mr_n {
        // place by hash alone: the compare in midx_put would
        // need the member as a &Vec<u8> value; members are
        // unique, so hash placement into empty cells suffices
        let mh: u64 = midx_hash_at(s, e, mr_j);
        let mp_mask: u64 = mr_cap - 1;
        let mp_pos: u64 = idx_mix(mh) & mp_mask;
        while s.entries[e].midx[mp_pos] != 0 {
            mp_pos = (mp_pos + 1) & mp_mask;
        }
        s.entries[e].midx[mp_pos] = (mr_j as i64) + 1;
        mr_j = mr_j + 1;
    }
}

// Build entry e's member index if it is not built. An empty
// midx means "not built" (payloads at or past MIDX_MIN build
// on first use; smaller payloads never call this).
fn midx_ensure(s: &Store, e: u64) {
    if len(s.entries[e].midx) == 0 {
        midx_rebuild(s, e);
    };
}

// Probe entry e's built member index for `member`: its position
// in the member sequence, or -1. Caller guarantees the index is
// built (midx_ensure) and the payload is at least MIDX_MIN.
fn midx_find(s: &Store, e: u64, member: &Vec<u8>) -> i64 {
    let mf_cap: u64 = len(s.entries[e].midx);
    let mf_mask: u64 = mf_cap - 1;
    let mf_pos: u64 = idx_mix(bytes_hash(member)) & mf_mask;
    let mf_n: u64 = 0;
    while mf_n < mf_cap {
        let mf_cell: i64 = s.entries[e].midx[mf_pos];
        if mf_cell == 0 {
            return -1;
        };
        if mf_cell != MIDX_TOMB {
            let mf_p: u64 = (mf_cell - 1) as u64;
            if midx_eq_at(s, e, mf_p, member) {
                return mf_p as i64;
            };
        };
        mf_pos = (mf_pos + 1) & mf_mask;
        mf_n = mf_n + 1;
    }
    return -1;
}

// Record a just-appended member (now the last position of entry
// e's payload). No-op when the index is not built, except that
// crossing the MIDX_MIN threshold builds it; when an insert
// would push the built index past its load factor the index is
// rebuilt at the fitted capacity instead.
fn midx_note_append(s: &Store, e: u64, member: &Vec<u8>) {
    let na_n: u64 = midx_len(s, e);
    if len(s.entries[e].midx) == 0 {
        if na_n >= MIDX_MIN {
            midx_rebuild(s, e);
        };
        return;
    };
    let na_cap: u64 = len(s.entries[e].midx);
    let na_live: u64 = na_n - 1;
    if (na_live + s.entries[e].midx_tombs + 1) * 10 > na_cap * 7 {
        midx_rebuild(s, e);
        return;
    };
    midx_put(s, e, bytes_hash(member), na_n - 1, member);
}

// Drop entry e's member index: the payload just lost or moved a
// member (a Vec::remove shift), so recorded positions may be
// stale. The next membership query at or past MIDX_MIN rebuilds.
fn midx_drop(s: &Store, e: u64) {
    s.entries[e].midx = Vec::new();
    s.entries[e].midx_tombs = 0;
}

// ---- free-slot min-heap (tombstone slot reuse) ----
//
// entry_tombstone pushes the freed slot; inserts claim the
// smallest one. Keeping the heap ordered reproduces the pre-B1
// scan's first-dead-slot choice bit for bit, which is what
// keeps the entries order (and AOF rewrite bytes) identical.

fn fh_push(s: &Store, slot: u64) {
    s.free_slots.push(slot);
    let fp_c: u64 = len(s.free_slots) - 1;
    while fp_c > 0 {
        let fp_p: u64 = (fp_c - 1) / 2;
        if s.free_slots[fp_p] <= s.free_slots[fp_c] {
            break;
        };
        let fp_t: u64 = s.free_slots[fp_p];
        s.free_slots[fp_p] = s.free_slots[fp_c];
        s.free_slots[fp_c] = fp_t;
        fp_c = fp_p;
    }
}

// Smallest reusable slot, or -1 when no tombstone is waiting.
fn fh_peek(s: &Store) -> i64 {
    if len(s.free_slots) == 0 {
        return -1;
    };
    return s.free_slots[0] as i64;
}

// Remove `slot` from the heap wherever it sits (insert claimed
// it). No-op when absent.
fn fh_discard(s: &Store, slot: u64) {
    let fd_n: u64 = len(s.free_slots);
    let fd_at: i64 = -1;
    let fd_i: u64 = 0;
    while fd_i < fd_n {
        if s.free_slots[fd_i] == slot {
            fd_at = fd_i as i64;
            break;
        };
        fd_i = fd_i + 1;
    }
    if fd_at < 0 {
        return;
    };
    let fd_pos: u64 = fd_at as u64;
    let fd_last = s.free_slots.pop();
    let fd_m: u64 = len(s.free_slots);
    if fd_pos >= fd_m {
        return;
    };
    match fd_last {
        Some(fd_v) => {
            s.free_slots[fd_pos] = fd_v;
        },
        None => {
            return;
        },
    };
    // The replacement element came from a leaf: sift it up when
    // it beats its parent, otherwise sift it down (the standard
    // one-direction heap delete).
    if fd_pos > 0 {
        let fd_pp: u64 = (fd_pos - 1) / 2;
        if s.free_slots[fd_pos] < s.free_slots[fd_pp] {
            let fd_c: u64 = fd_pos;
            while fd_c > 0 {
                let fd_p2: u64 = (fd_c - 1) / 2;
                if s.free_slots[fd_p2] <= s.free_slots[fd_c] {
                    break;
                };
                let fd_t: u64 = s.free_slots[fd_p2];
                s.free_slots[fd_p2] = s.free_slots[fd_c];
                s.free_slots[fd_c] = fd_t;
                fd_c = fd_p2;
            }
            return;
        };
    };
    let fd_c2: u64 = fd_pos;
    while true {
        let fd_l: u64 = fd_c2 * 2 + 1;
        let fd_r: u64 = fd_l + 1;
        let fd_small: u64 = fd_c2;
        if fd_l < fd_m {
            if s.free_slots[fd_l] < s.free_slots[fd_small] {
                fd_small = fd_l;
            };
        };
        if fd_r < fd_m {
            if s.free_slots[fd_r] < s.free_slots[fd_small] {
                fd_small = fd_r;
            };
        };
        if fd_small == fd_c2 {
            break;
        };
        let fd_t2: u64 = s.free_slots[fd_small];
        s.free_slots[fd_small] = s.free_slots[fd_c2];
        s.free_slots[fd_c2] = fd_t2;
        fd_c2 = fd_small;
    }
}

// Release an entry's payloads and mark it dead. The key bytes are
// kept (harmless; the slot is reused or compacted later). The
// key leaves the B1 index and the slot joins the free-slot heap.
fn entry_tombstone(s: &Store, i: u64) {
    if s.entries[i].kind == KIND_DEAD {
        return;
    };
    idx_remove(s, s.entries[i].key_hash, i);
    s.entries[i].kind = KIND_DEAD;
    s.entries[i].expire_ms = 0;
    s.entries[i].enc = ENC_PLAIN;
    s.entries[i].pack = Vec::new();
    s.entries[i].sval = Vec::new();
    s.entries[i].hfields = Vec::new();
    s.entries[i].hvalues = Vec::new();
    s.entries[i].litems = Vec::new();
    s.entries[i].lhead = 0;
    s.entries[i].smembers = Vec::new();
    s.entries[i].zrows = Vec::new();
    s.entries[i].midx = Vec::new();
    s.entries[i].midx_tombs = 0;
    s.dead_count = s.dead_count + 1;
    fh_push(s, i);
}

// Reset a live entry in place to a new kind with empty payloads
// and no expiry (SET overwriting an existing key uses this; the
// slot stays live, unlike entry_tombstone).
fn entry_reset(s: &Store, i: u64, kind: u8) {
    s.entries[i].kind = kind;
    s.entries[i].expire_ms = 0;
    s.entries[i].enc = ENC_PLAIN;
    s.entries[i].pack = Vec::new();
    s.entries[i].sval = Vec::new();
    s.entries[i].hfields = Vec::new();
    s.entries[i].hvalues = Vec::new();
    s.entries[i].litems = Vec::new();
    s.entries[i].lhead = 0;
    s.entries[i].smembers = Vec::new();
    s.entries[i].zrows = Vec::new();
    s.entries[i].midx = Vec::new();
    s.entries[i].midx_tombs = 0;
}

fn entry_expired(s: &Store, i: u64, now_ms: i64) -> bool {
    if s.entries[i].expire_ms == 0 {
        return false;
    };
    if s.entries[i].expire_ms <= now_ms {
        return true;
    };
    return false;
}

// Logical length of the list in entry i (physical slots below
// lhead are released headroom, not elements).
fn list_len(s: &Store, i: u64) -> u64 {
    return len(s.entries[i].litems) - s.entries[i].lhead;
}

// Prepend one element to the list in entry e (F-perf-3). O(1)
// while headroom remains under lhead; when it runs out, the
// physical vector is rebuilt once with fresh headroom roughly
// equal to the list length, MOVING the element Vecs (header
// copies only -- no byte clones of existing elements), so head
// pushes stay amortized O(1). The old M1 shape rebuilt the
// whole list with a deep clone of every element per push.
fn list_push_head(s: &Store, e: u64, val: &Vec<u8>) {
    if s.entries[e].lhead > 0 {
        s.entries[e].lhead = s.entries[e].lhead - 1;
        let h: u64 = s.entries[e].lhead;
        s.entries[e].litems[h] = bytes_clone(val);
        return;
    };
    // No headroom: rebuild with room in front. The old vector
    // is moved out (the field move-out shape server.sla uses
    // for connection buffers); its elements are popped off the
    // back and written into their final slots back-to-front,
    // preserving order with header moves only. (Local names are
    // ph_-prefixed: after inline expansion they share the
    // caller's register namespace, and plain names like v/idx
    // collide with caller registers at merges -- the M1 referee
    // minefield.)
    let ph_n: u64 = len(s.entries[e].litems);
    let ph_room: u64 = ph_n;
    if ph_room < 16 {
        ph_room = 16;
    };
    let ph_old = s.entries[e].litems;
    let ph_fresh: Vec<Vec<u8>> = Vec::new();
    let ph_k: u64 = 0;
    while ph_k < ph_room + ph_n {
        ph_fresh.push(Vec::new());
        ph_k = ph_k + 1;
    }
    let ph_src = ph_old;
    let ph_idx: u64 = ph_n;
    while ph_idx > 0 {
        ph_idx = ph_idx - 1;
        match ph_src.pop() {
            Some(ph_v) => {
                ph_fresh[ph_room + ph_idx] = ph_v;
            },
            None => {
            },
        };
    }
    s.entries[e].litems = ph_fresh;
    s.entries[e].lhead = ph_room - 1;
    s.entries[e].litems[ph_room - 1] = bytes_clone(val);
}

// Remove and return the head element of the list in entry e
// (the caller guarantees the list is non-empty). The value is
// byte-copied out, the vacated slot is released in place and
// lhead advances: O(1) plus one element copy, no shifting and
// no rebuild (the old shape used Vec::remove(0)).
fn list_pop_head(s: &Store, e: u64) -> Vec<u8> {
    let hp_h: u64 = s.entries[e].lhead;
    let hp_val = bytes_clone(&s.entries[e].litems[hp_h]);
    s.entries[e].litems[hp_h] = Vec::new();
    s.entries[e].lhead = hp_h + 1;
    return hp_val;
}

// One probe that answers both questions the create paths used
// to pay a full scan for (F-perf-5; since B1 an index probe
// instead of the scan): the live index of `key` (-1 when absent,
// with store_find's lazy-expiry semantics) and the first
// tombstone slot an insert may reuse (-1 when none). "First" is
// literal: the free-slot heap's minimum is exactly the slot the
// old scan met first, and when the key's own entry turns out
// expired it is tombstoned (which pushes its slot on the heap)
// before the minimum is read -- so the returned pair, and the
// entries order every insert produces, are identical to the
// scan's, exactly as the old find-then-insert sequence behaved.
fn store_find_slot(s: &Store, key: &Vec<u8>, key_hash: u64, now_ms: i64) -> (i64, i64) {
    let (fs_idx, _fs_cell) = idx_probe(s, key, key_hash);
    if fs_idx < 0 {
        return (-1, fh_peek(s));
    };
    let fs_u: u64 = fs_idx as u64;
    if entry_expired(s, fs_u, now_ms) {
        entry_tombstone(s, fs_u);
        return (-1, fh_peek(s));
    };
    // Live hit: the old scan only reported tombstones it had
    // passed before reaching the key, i.e. slots < fs_idx; the
    // heap minimum qualifies exactly when it precedes the hit.
    let fs_d: i64 = fh_peek(s);
    if fs_d >= fs_idx {
        return (fs_idx, -1);
    };
    return (fs_idx, fs_d);
}

// Find a live entry by key. Applies lazy expiry: an expired entry
// is tombstoned and reported missing. Returns the index or -1.
fn store_find(s: &Store, key: &Vec<u8>, key_hash: u64, now_ms: i64) -> i64 {
    let (idx, _dead) = store_find_slot(s, key, key_hash, now_ms);
    return idx;
}

// Insert a fresh entry of the given kind into the tombstone slot
// `dead` (from store_find_slot), or append when dead < 0. The
// caller has verified the key is absent. The B1 index gains the
// key (growing/rehashing first when the load factor demands)
// and the claimed slot leaves the free-slot heap.
fn store_insert_at(s: &Store, key: &Vec<u8>, key_hash: u64, kind: u8, dead: i64) -> i64 {
    idx_ensure(s);
    if dead >= 0 {
        let d: u64 = dead as u64;
        fh_discard(s, d);
        s.entries[d] = entry_blank(key, key_hash, kind);
        s.dead_count = s.dead_count - 1;
        idx_insert(s, key, key_hash, d);
        return dead;
    };
    s.entries.push(entry_blank(key, key_hash, kind));
    let ni: u64 = len(s.entries) - 1;
    idx_insert(s, key, key_hash, ni);
    return ni as i64;
}

// Insert a fresh entry of the given kind (caller has verified the
// key is absent). Reuses the smallest tombstone slot when one
// exists -- the slot the pre-B1 scan found first.
fn store_insert(s: &Store, key: &Vec<u8>, key_hash: u64, kind: u8) -> i64 {
    return store_insert_at(s, key, key_hash, kind, fh_peek(s));
}

// Switch a fresh aggregate entry to the packed representation
// (hash / set / zset creation path).
fn entry_make_packed(s: &Store, i: u64) {
    s.entries[i].enc = ENC_PACKED;
    s.entries[i].pack = lp_new();
}

// Logical element count of a packed entry: fields for a hash,
// members for a set, members (half the pack elements) for a zset.
// Returns 0 for a plain entry.
fn pack_logical_count(s: &Store, i: u64) -> u64 {
    if s.entries[i].enc != ENC_PACKED {
        return 0;
    };
    let n: u64 = lp_count(&s.entries[i].pack);
    if s.entries[i].kind == KIND_SET {
        return n;
    };
    return n / 2;
}

// Deep copy of an entry, PRESERVING its representation (a packed
// entry clones its pack bytes; a plain entry clones its vectors).
fn entry_clone(s: &Store, i: u64) -> Entry {
    let e = entry_blank(&s.entries[i].key, s.entries[i].key_hash, s.entries[i].kind);
    e.expire_ms = s.entries[i].expire_ms;
    e.enc = s.entries[i].enc;
    e.pack = bytes_clone(&s.entries[i].pack);
    e.sval = bytes_clone(&s.entries[i].sval);
    let k: u64 = 0;
    while k < len(s.entries[i].hfields) {
        e.hfields.push(bytes_clone(&s.entries[i].hfields[k]));
        e.hvalues.push(bytes_clone(&s.entries[i].hvalues[k]));
        k = k + 1;
    }
    // Lists clone in logical order with the head offset
    // normalized away: the clone's lhead stays 0 (entry_blank).
    let m: u64 = s.entries[i].lhead;
    while m < len(s.entries[i].litems) {
        e.litems.push(bytes_clone(&s.entries[i].litems[m]));
        m = m + 1;
    }
    let q: u64 = 0;
    while q < len(s.entries[i].smembers) {
        e.smembers.push(bytes_clone(&s.entries[i].smembers[q]));
        q = q + 1;
    }
    let z: u64 = 0;
    while z < len(s.entries[i].zrows) {
        e.zrows.push(ZRow { member: bytes_clone(&s.entries[i].zrows[z].member), score: s.entries[i].zrows[z].score });
        z = z + 1;
    }
    return e;
}

// Decode the pack of entry i (a packed zset) into a fresh rows
// vector: the pack is borrowed in place, the rows are built in a
// local Vec<ZRow> and returned whole. This is the single zset
// pack decode in the codebase (Form 3, Jev ruling
// form3_single_attempt_then_def): entry_decode_pack installs its
// result into the materialized entry with one assignment, and
// commands.sla's pack_zrows delegates here for pack reads.
fn store_pack_zrows(s: &Store, i: u64) -> Vec<ZRow> {
    let rows: Vec<ZRow> = Vec::new();
    let pk = &s.entries[i].pack;
    let count: u64 = lp_count(pk);
    let pos: u64 = 6;
    let n: u64 = 0;
    while n < count {
        // member materialized only on the consuming path (see
        // entry_decode_pack for the referee constraint)
        let mpos: u64 = pos;
        pos = lp_next(pk, pos);
        let stext = lp_value_new(pk, pos);
        pos = lp_next(pk, pos);
        // zset payload is the score text written by fmt_f64;
        // parse_f64_full accepts every form fmt_f64 emits (plain
        // decimal, exponent, inf) -- an invariant the round-trip
        // tests exercise, including extreme scores.
        let (ok, sc) = parse_f64_full(&stext);
        if ok {
            let member = lp_value_new(pk, mpos);
            rows.push(ZRow { member: member, score: sc });
        };
        n = n + 2;
    }
    return rows;
}

// Decode the pack of entry i into the payload vectors of the
// owned entry `e` (same kind). The pack is cloned first so the
// loops read a local while filling `e`.
fn entry_decode_pack(s: &Store, i: u64, e: Entry) -> Entry {
    let pk = bytes_clone(&s.entries[i].pack);
    let count: u64 = lp_count(&pk);
    if s.entries[i].kind == KIND_SET {
        let pos: u64 = 6;
        let n: u64 = 0;
        while n < count {
            e.smembers.push(lp_value_new(&pk, pos));
            pos = lp_next(&pk, pos);
            n = n + 1;
        }
        return e;
    };
    // hash and zset store flat (name, payload) element pairs.
    // The two kinds get separate loops (the kind is fixed for the
    // whole entry): mixing them in one loop body makes the payload
    // register consumed on the hash path and merely borrowed on
    // the zset path, which the referee rejects at the loop merge.
    if s.entries[i].kind == KIND_HASH {
        let pos2: u64 = 6;
        let n2: u64 = 0;
        while n2 < count {
            let name = lp_value_new(&pk, pos2);
            pos2 = lp_next(&pk, pos2);
            let payload = lp_value_new(&pk, pos2);
            pos2 = lp_next(&pk, pos2);
            e.hfields.push(name);
            e.hvalues.push(payload);
            n2 = n2 + 2;
        }
        return e;
    };
    // zset: the rows are produced whole by store_pack_zrows (the
    // pack_zrows shape) and installed with a single assignment.
    e.zrows = store_pack_zrows(s, i);
    return e;
}

// A decoded, plain-representation deep copy of entry i: packed
// entries are materialized into payload vectors, plain entries
// are cloned. The source entry is untouched. The AOF dataset
// serializer works only with materialized entries.
fn entry_materialized(s: &Store, i: u64) -> Entry {
    let e = entry_blank(&s.entries[i].key, s.entries[i].key_hash, s.entries[i].kind);
    e.expire_ms = s.entries[i].expire_ms;
    if s.entries[i].enc == ENC_PACKED {
        let e2 = entry_decode_pack(s, i, e);
        return e2;
    };
    let c = entry_clone(s, i);
    return c;
}

// One-way conversion of a packed entry to the plain (M0 vector)
// representation, in place, payload-preserving.
fn entry_convert_plain(s: &Store, i: u64) {
    if s.entries[i].enc != ENC_PACKED {
        return;
    };
    let m = entry_materialized(s, i);
    s.entries[i].hfields = m.hfields;
    s.entries[i].hvalues = m.hvalues;
    s.entries[i].smembers = m.smembers;
    s.entries[i].zrows = m.zrows;
    s.entries[i].enc = ENC_PLAIN;
    s.entries[i].pack = Vec::new();
    s.entries[i].midx = Vec::new();
    s.entries[i].midx_tombs = 0;
}

// Active expiry sweep + tombstone compaction. Called periodically
// from the server loop. Returns how many keys the sweep expired.
fn store_sweep(s: &Store, now_ms: i64) -> u64 {
    let removed: u64 = 0;
    let i: u64 = 0;
    while i < len(s.entries) {
        if s.entries[i].kind != KIND_DEAD {
            if entry_expired(s, i, now_ms) {
                entry_tombstone(s, i);
                removed = removed + 1;
            };
        };
        i = i + 1;
    }
    // Compact when tombstones are at least half the table and
    // non-trivial in number: rebuild with deep copies of live rows.
    if s.dead_count >= 64 {
        if s.dead_count * 2 >= len(s.entries) {
            let fresh: Vec<Entry> = Vec::new();
            let j: u64 = 0;
            while j < len(s.entries) {
                if s.entries[j].kind != KIND_DEAD {
                    fresh.push(entry_clone(s, j));
                };
                j = j + 1;
            }
            s.entries = fresh;
            s.dead_count = 0;
            // Compaction renumbered every entry: the free-slot
            // heap is empty by construction (no tombstones
            // survive) and the B1 index is rebuilt over the new
            // numbering at fit capacity.
            s.free_slots = Vec::new();
            idx_rehash(s, idx_cap_for(len(s.entries)));
        };
    };
    return removed;
}
