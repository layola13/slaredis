// store.sla -- the slaredis keyspace.
//
// Representation:
//   One Entry per key in a single Vec, found by linear scan with an
//   FNV-1a pre-filter. Payloads live inline in the Entry as Vec<u8>
//   byte strings / Vec pairs. Since M1, small aggregates (hash /
//   set / zset) start in the compact listpack representation
//   (Entry.pack, listpack.sla) and convert one-way to the plain
//   vectors past the thresholds declared below -- the same shape
//   Redis uses, with intset/skiplist/rax still future work.
//   Deletion and expiry tombstone the entry (kind = KIND_DEAD,
//   payloads released); insert reuses dead slots, and the sweeper
//   compacts when tombstones dominate.
//
// Expiry: expire_ms is a unix-ms deadline, 0 = no expiry. Expiry is
// enforced lazily inside store_find (an expired key is tombstoned
// and reported missing) and actively by store_sweep from the server
// loop.
@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"
@import "sa_std/core/slice.sa"
@import "bytes.sla"
@import "listpack.sla"

const KIND_DEAD: u8 = 0;
const KIND_STRING: u8 = 1;
const KIND_HASH: u8 = 2;
const KIND_LIST: u8 = 3;
const KIND_SET: u8 = 4;
const KIND_ZSET: u8 = 5;

// Value representations (M1). Aggregate kinds (hash / set / zset)
// start PACKED: their elements live in one listpack byte string
// (Entry.pack, see listpack.sla) and the payload vectors stay
// empty. When a packed aggregate grows past the thresholds below
// it converts one-way to PLAIN (the M0 vectors), exactly like
// Redis's listpack -> hashtable/skiplist conversion. Strings and
// lists are always PLAIN.
const ENC_PLAIN: u8 = 0;
const ENC_PACKED: u8 = 1;

// Conversion thresholds (Redis defaults): a packed aggregate
// converts when a write would push it past 128 logical elements
// (hash fields / set members / zset members) or would insert an
// element longer than 64 bytes.
const PACK_MAX_LOGICAL: u64 = 128;
const PACK_MAX_ELEM_BYTES: u64 = 64;

// One sorted-set row. Scores live in a struct field because bare
// Vec<f64> element reads return 0.0 with the current toolchain
// (minimal repro in docs/M0_DELIVERY.md); struct-field f64 access
// is verified correct.
struct ZRow {
    member: Vec<u8>,
    score: f64,
}

struct Entry {
    key: Vec<u8>,
    key_hash: u64,
    kind: u8,
    expire_ms: i64,
    enc: u8,
    pack: Vec<u8>,
    sval: Vec<u8>,
    hfields: Vec<Vec<u8>>,
    hvalues: Vec<Vec<u8>>,
    litems: Vec<Vec<u8>>,
    // Head offset of the list deque (F-perf-3): the logical list
    // is litems[lhead .. len(litems)], so LPUSH/LPOP at the head
    // are O(1) slot operations instead of O(n) deep-clone
    // rebuilds. Slots below lhead hold released (empty) values.
    // entry_clone / entry_materialized always normalize a list
    // back to lhead == 0, so consumers outside the list commands
    // (the AOF serializer) never see the offset.
    lhead: u64,
    smembers: Vec<Vec<u8>>,
    zrows: Vec<ZRow>,
}

struct Store {
    entries: Vec<Entry>,
    dead_count: u64,
}

fn entry_blank(key: &Vec<u8>, key_hash: u64, kind: u8) -> Entry {
    return Entry {
        key: bytes_clone(key),
        key_hash: key_hash,
        kind: kind,
        expire_ms: 0,
        enc: ENC_PLAIN,
        pack: Vec::new(),
        sval: Vec::new(),
        hfields: Vec::new(),
        hvalues: Vec::new(),
        litems: Vec::new(),
        lhead: 0,
        smembers: Vec::new(),
        zrows: Vec::new(),
    };
}

fn store_new() -> Store {
    return Store { entries: Vec::new(), dead_count: 0 };
}

// Release an entry's payloads and mark it dead. The key bytes are
// kept (harmless; the slot is reused or compacted later).
fn entry_tombstone(s: &Store, i: u64) {
    if s.entries[i].kind == KIND_DEAD {
        return;
    };
    s.entries[i].kind = KIND_DEAD;
    s.entries[i].expire_ms = 0;
    s.entries[i].enc = ENC_PLAIN;
    s.entries[i].pack = Vec::new();
    s.entries[i].sval = Vec::new();
    s.entries[i].hfields = Vec::new();
    s.entries[i].hvalues = Vec::new();
    s.entries[i].litems = Vec::new();
    s.entries[i].lhead = 0;
    s.entries[i].smembers = Vec::new();
    s.entries[i].zrows = Vec::new();
    s.dead_count = s.dead_count + 1;
}

// Reset a live entry in place to a new kind with empty payloads
// and no expiry (SET overwriting an existing key uses this; the
// slot stays live, unlike entry_tombstone).
fn entry_reset(s: &Store, i: u64, kind: u8) {
    s.entries[i].kind = kind;
    s.entries[i].expire_ms = 0;
    s.entries[i].enc = ENC_PLAIN;
    s.entries[i].pack = Vec::new();
    s.entries[i].sval = Vec::new();
    s.entries[i].hfields = Vec::new();
    s.entries[i].hvalues = Vec::new();
    s.entries[i].litems = Vec::new();
    s.entries[i].lhead = 0;
    s.entries[i].smembers = Vec::new();
    s.entries[i].zrows = Vec::new();
}

fn entry_expired(s: &Store, i: u64, now_ms: i64) -> bool {
    if s.entries[i].expire_ms == 0 {
        return false;
    };
    if s.entries[i].expire_ms <= now_ms {
        return true;
    };
    return false;
}

// Logical length of the list in entry i (physical slots below
// lhead are released headroom, not elements).
fn list_len(s: &Store, i: u64) -> u64 {
    return len(s.entries[i].litems) - s.entries[i].lhead;
}

// Prepend one element to the list in entry e (F-perf-3). O(1)
// while headroom remains under lhead; when it runs out, the
// physical vector is rebuilt once with fresh headroom roughly
// equal to the list length, MOVING the element Vecs (header
// copies only -- no byte clones of existing elements), so head
// pushes stay amortized O(1). The old M1 shape rebuilt the
// whole list with a deep clone of every element per push.
fn list_push_head(s: &Store, e: u64, val: &Vec<u8>) {
    if s.entries[e].lhead > 0 {
        s.entries[e].lhead = s.entries[e].lhead - 1;
        let h: u64 = s.entries[e].lhead;
        s.entries[e].litems[h] = bytes_clone(val);
        return;
    };
    // No headroom: rebuild with room in front. The old vector
    // is moved out (the field move-out shape server.sla uses
    // for connection buffers); its elements are popped off the
    // back and written into their final slots back-to-front,
    // preserving order with header moves only. (Local names are
    // ph_-prefixed: after inline expansion they share the
    // caller's register namespace, and plain names like v/idx
    // collide with caller registers at merges -- the M1 referee
    // minefield.)
    let ph_n: u64 = len(s.entries[e].litems);
    let ph_room: u64 = ph_n;
    if ph_room < 16 {
        ph_room = 16;
    };
    let ph_old = s.entries[e].litems;
    let ph_fresh: Vec<Vec<u8>> = Vec::new();
    let ph_k: u64 = 0;
    while ph_k < ph_room + ph_n {
        ph_fresh.push(Vec::new());
        ph_k = ph_k + 1;
    }
    let ph_src = ph_old;
    let ph_idx: u64 = ph_n;
    while ph_idx > 0 {
        ph_idx = ph_idx - 1;
        match ph_src.pop() {
            Some(ph_v) => {
                ph_fresh[ph_room + ph_idx] = ph_v;
            },
            None => {
            },
        };
    }
    s.entries[e].litems = ph_fresh;
    s.entries[e].lhead = ph_room - 1;
    s.entries[e].litems[ph_room - 1] = bytes_clone(val);
}

// Remove and return the head element of the list in entry e
// (the caller guarantees the list is non-empty). The value is
// byte-copied out, the vacated slot is released in place and
// lhead advances: O(1) plus one element copy, no shifting and
// no rebuild (the old shape used Vec::remove(0)).
fn list_pop_head(s: &Store, e: u64) -> Vec<u8> {
    let hp_h: u64 = s.entries[e].lhead;
    let hp_val = bytes_clone(&s.entries[e].litems[hp_h]);
    s.entries[e].litems[hp_h] = Vec::new();
    s.entries[e].lhead = hp_h + 1;
    return hp_val;
}

// One scan that answers both questions the create paths used to
// pay two full scans for (F-perf-5): the live index of `key`
// (-1 when absent, with store_find's lazy-expiry semantics) and
// the first tombstone slot an insert may reuse (-1 when none).
// When the key's own entry turns out expired it is tombstoned
// and becomes the reuse candidate, exactly as the old find-then-
// insert sequence behaved.
fn store_find_slot(s: &Store, key: &Vec<u8>, key_hash: u64, now_ms: i64) -> (i64, i64) {
    let fs_dead: i64 = -1;
    let fs_i: u64 = 0;
    while fs_i < len(s.entries) {
        if s.entries[fs_i].kind == KIND_DEAD {
            if fs_dead < 0 {
                fs_dead = fs_i as i64;
            };
        } else {
            if s.entries[fs_i].key_hash == key_hash {
                if bytes_eq(&s.entries[fs_i].key, key) {
                    if entry_expired(s, fs_i, now_ms) {
                        entry_tombstone(s, fs_i);
                        if fs_dead < 0 {
                            fs_dead = fs_i as i64;
                        };
                        return (-1, fs_dead);
                    };
                    return (fs_i as i64, fs_dead);
                };
            };
        };
        fs_i = fs_i + 1;
    }
    return (-1, fs_dead);
}

// Find a live entry by key. Applies lazy expiry: an expired entry
// is tombstoned and reported missing. Returns the index or -1.
fn store_find(s: &Store, key: &Vec<u8>, key_hash: u64, now_ms: i64) -> i64 {
    let (idx, _dead) = store_find_slot(s, key, key_hash, now_ms);
    return idx;
}

// Insert a fresh entry of the given kind into the tombstone slot
// `dead` (from store_find_slot), or append when dead < 0. The
// caller has verified the key is absent.
fn store_insert_at(s: &Store, key: &Vec<u8>, key_hash: u64, kind: u8, dead: i64) -> i64 {
    if dead >= 0 {
        let d: u64 = dead as u64;
        s.entries[d] = entry_blank(key, key_hash, kind);
        s.dead_count = s.dead_count - 1;
        return dead;
    };
    s.entries.push(entry_blank(key, key_hash, kind));
    return (len(s.entries) - 1) as i64;
}

// Insert a fresh entry of the given kind (caller has verified the
// key is absent). Reuses a tombstone slot when one exists.
fn store_insert(s: &Store, key: &Vec<u8>, key_hash: u64, kind: u8) -> i64 {
    let i: u64 = 0;
    while i < len(s.entries) {
        if s.entries[i].kind == KIND_DEAD {
            return store_insert_at(s, key, key_hash, kind, i as i64);
        };
        i = i + 1;
    }
    return store_insert_at(s, key, key_hash, kind, -1);
}

// Switch a fresh aggregate entry to the packed representation
// (hash / set / zset creation path).
fn entry_make_packed(s: &Store, i: u64) {
    s.entries[i].enc = ENC_PACKED;
    s.entries[i].pack = lp_new();
}

// Logical element count of a packed entry: fields for a hash,
// members for a set, members (half the pack elements) for a zset.
// Returns 0 for a plain entry.
fn pack_logical_count(s: &Store, i: u64) -> u64 {
    if s.entries[i].enc != ENC_PACKED {
        return 0;
    };
    let n: u64 = lp_count(&s.entries[i].pack);
    if s.entries[i].kind == KIND_SET {
        return n;
    };
    return n / 2;
}

// Deep copy of an entry, PRESERVING its representation (a packed
// entry clones its pack bytes; a plain entry clones its vectors).
fn entry_clone(s: &Store, i: u64) -> Entry {
    let e = entry_blank(&s.entries[i].key, s.entries[i].key_hash, s.entries[i].kind);
    e.expire_ms = s.entries[i].expire_ms;
    e.enc = s.entries[i].enc;
    e.pack = bytes_clone(&s.entries[i].pack);
    e.sval = bytes_clone(&s.entries[i].sval);
    let k: u64 = 0;
    while k < len(s.entries[i].hfields) {
        e.hfields.push(bytes_clone(&s.entries[i].hfields[k]));
        e.hvalues.push(bytes_clone(&s.entries[i].hvalues[k]));
        k = k + 1;
    }
    // Lists clone in logical order with the head offset
    // normalized away: the clone's lhead stays 0 (entry_blank).
    let m: u64 = s.entries[i].lhead;
    while m < len(s.entries[i].litems) {
        e.litems.push(bytes_clone(&s.entries[i].litems[m]));
        m = m + 1;
    }
    let q: u64 = 0;
    while q < len(s.entries[i].smembers) {
        e.smembers.push(bytes_clone(&s.entries[i].smembers[q]));
        q = q + 1;
    }
    let z: u64 = 0;
    while z < len(s.entries[i].zrows) {
        e.zrows.push(ZRow { member: bytes_clone(&s.entries[i].zrows[z].member), score: s.entries[i].zrows[z].score });
        z = z + 1;
    }
    return e;
}

// Decode the pack of entry i (a packed zset) into a fresh rows
// vector: the pack is borrowed in place, the rows are built in a
// local Vec<ZRow> and returned whole. This is the single zset
// pack decode in the codebase (Form 3, Jev ruling
// form3_single_attempt_then_def): entry_decode_pack installs its
// result into the materialized entry with one assignment, and
// commands.sla's pack_zrows delegates here for pack reads.
fn store_pack_zrows(s: &Store, i: u64) -> Vec<ZRow> {
    let rows: Vec<ZRow> = Vec::new();
    let pk = &s.entries[i].pack;
    let count: u64 = lp_count(pk);
    let pos: u64 = 6;
    let n: u64 = 0;
    while n < count {
        // member materialized only on the consuming path (see
        // entry_decode_pack for the referee constraint)
        let mpos: u64 = pos;
        pos = lp_next(pk, pos);
        let stext = lp_value_new(pk, pos);
        pos = lp_next(pk, pos);
        // zset payload is the score text written by fmt_f64;
        // parse_f64_full accepts every form fmt_f64 emits (plain
        // decimal, exponent, inf) -- an invariant the round-trip
        // tests exercise, including extreme scores.
        let (ok, sc) = parse_f64_full(&stext);
        if ok {
            let member = lp_value_new(pk, mpos);
            rows.push(ZRow { member: member, score: sc });
        };
        n = n + 2;
    }
    return rows;
}

// Decode the pack of entry i into the payload vectors of the
// owned entry `e` (same kind). The pack is cloned first so the
// loops read a local while filling `e`.
fn entry_decode_pack(s: &Store, i: u64, e: Entry) -> Entry {
    let pk = bytes_clone(&s.entries[i].pack);
    let count: u64 = lp_count(&pk);
    if s.entries[i].kind == KIND_SET {
        let pos: u64 = 6;
        let n: u64 = 0;
        while n < count {
            e.smembers.push(lp_value_new(&pk, pos));
            pos = lp_next(&pk, pos);
            n = n + 1;
        }
        return e;
    };
    // hash and zset store flat (name, payload) element pairs.
    // The two kinds get separate loops (the kind is fixed for the
    // whole entry): mixing them in one loop body makes the payload
    // register consumed on the hash path and merely borrowed on
    // the zset path, which the referee rejects at the loop merge.
    if s.entries[i].kind == KIND_HASH {
        let pos2: u64 = 6;
        let n2: u64 = 0;
        while n2 < count {
            let name = lp_value_new(&pk, pos2);
            pos2 = lp_next(&pk, pos2);
            let payload = lp_value_new(&pk, pos2);
            pos2 = lp_next(&pk, pos2);
            e.hfields.push(name);
            e.hvalues.push(payload);
            n2 = n2 + 2;
        }
        return e;
    };
    // zset: the rows are produced whole by store_pack_zrows (the
    // pack_zrows shape) and installed with a single assignment.
    e.zrows = store_pack_zrows(s, i);
    return e;
}

// A decoded, plain-representation deep copy of entry i: packed
// entries are materialized into payload vectors, plain entries
// are cloned. The source entry is untouched. The AOF dataset
// serializer works only with materialized entries.
fn entry_materialized(s: &Store, i: u64) -> Entry {
    let e = entry_blank(&s.entries[i].key, s.entries[i].key_hash, s.entries[i].kind);
    e.expire_ms = s.entries[i].expire_ms;
    if s.entries[i].enc == ENC_PACKED {
        let e2 = entry_decode_pack(s, i, e);
        return e2;
    };
    let c = entry_clone(s, i);
    return c;
}

// One-way conversion of a packed entry to the plain (M0 vector)
// representation, in place, payload-preserving.
fn entry_convert_plain(s: &Store, i: u64) {
    if s.entries[i].enc != ENC_PACKED {
        return;
    };
    let m = entry_materialized(s, i);
    s.entries[i].hfields = m.hfields;
    s.entries[i].hvalues = m.hvalues;
    s.entries[i].smembers = m.smembers;
    s.entries[i].zrows = m.zrows;
    s.entries[i].enc = ENC_PLAIN;
    s.entries[i].pack = Vec::new();
}

// Active expiry sweep + tombstone compaction. Called periodically
// from the server loop. Returns how many keys the sweep expired.
fn store_sweep(s: &Store, now_ms: i64) -> u64 {
    let removed: u64 = 0;
    let i: u64 = 0;
    while i < len(s.entries) {
        if s.entries[i].kind != KIND_DEAD {
            if entry_expired(s, i, now_ms) {
                entry_tombstone(s, i);
                removed = removed + 1;
            };
        };
        i = i + 1;
    }
    // Compact when tombstones are at least half the table and
    // non-trivial in number: rebuild with deep copies of live rows.
    if s.dead_count >= 64 {
        if s.dead_count * 2 >= len(s.entries) {
            let fresh: Vec<Entry> = Vec::new();
            let j: u64 = 0;
            while j < len(s.entries) {
                if s.entries[j].kind != KIND_DEAD {
                    fresh.push(entry_clone(s, j));
                };
                j = j + 1;
            }
            s.entries = fresh;
            s.dead_count = 0;
        };
    };
    return removed;
}
